generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Lead {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  phone     String   @db.VarChar(30)
  model     String   @db.VarChar(80)
  land      String   @db.VarChar(40)
  location  String   @db.VarChar(120)
  status    LeadStatus @default(NEW)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model HouseModel {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  area        Int
  description String   @db.VarChar(255)
  image       String   @db.VarChar(255)
  videoId     String?  @db.VarChar(30)
  priceUsd    Decimal? @db.Decimal(12, 2)
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())
}

model Work {
  id        Int      @id @default(autoincrement())
  name      String?  @db.VarChar(120)
  model     String   @db.VarChar(20)
  area      Int?
  bedrooms  Int?
  bathrooms Int?
  status    String   @default("ENTREGADA") @db.VarChar(30)
  department String  @db.VarChar(60)
  location  String   @db.VarChar(120)
  photo     String   @db.VarChar(255)
  photos    Json
  panoramas Json?
  youtubeId String?  @db.VarChar(255)
  deliveredAt DateTime?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}

model Project {
  id        Int      @id @default(autoincrement())
  slug      String   @unique @db.VarChar(60)
  name      String   @db.VarChar(120)
  status    String   @db.VarChar(60)
  cover     String   @db.VarChar(255)
  photos    Json
  panoramas Json?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}

model ProjectStatus {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(60)
  createdAt DateTime @default(now())
}

model User {
  id           Int      @id @default(autoincrement())
  firstName    String   @db.VarChar(80)
  lastName     String   @db.VarChar(80)
  email        String   @unique @db.VarChar(191)
  passwordHash String?  @db.VarChar(255)
  googleId     String?  @unique @db.VarChar(191)
  role         UserRole @default(DIRECTOR)
  active       Boolean  @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assignedChats ChatConversation[] @relation("AssignedChats")
  chatMessages  ChatMessage[]
}

model ChatConversation {
  id           Int        @id @default(autoincrement())
  publicId     String     @unique @db.Char(36)
  name         String     @db.VarChar(100)
  email        String     @db.VarChar(191)
  phone        String     @db.VarChar(30)
  status       ChatStatus @default(WAITING)
  priority     ChatPriority @default(MEDIUM)
  tags         Json
  assignedToId Int?
  assignedTo   User?      @relation("AssignedChats", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages     ChatMessage[]
  lastMessageAt DateTime  @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status, priority, lastMessageAt])
  @@index([assignedToId])
}

model ChatMessage {
  id             Int              @id @default(autoincrement())
  conversationId Int
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         ChatSender
  text           String           @db.Text
  advisorId      Int?
  advisor        User?            @relation(fields: [advisorId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@index([advisorId])
}

enum ChatStatus {
  WAITING
  ACTIVE
  CLOSED
}

enum ChatPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ChatSender {
  VISITOR
  ADVISOR
  SYSTEM
}

enum UserRole {
  ADMIN
  DIRECTOR
}

model PortalAccess {
  id         Int       @id @default(autoincrement())
  tokenHash  String    @unique @db.Char(64)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
}

model BusinessProfile {
  id                 Int      @id @default(1)
  serviceYearsMode   String   @default("AUTOMATIC") @db.VarChar(20)
  serviceStartDate   DateTime?
  manualServiceYears Int?
  houseCountMode     String   @default("AUTOMATIC") @db.VarChar(20)
  manualHouseCount   Int?
  googleRating       Float?
  googleReviewCount  Int?
  googleMapsUri      String?  @db.Text
  googleReviewsSyncedAt DateTime?
  updatedAt          DateTime @updatedAt @default(now())
}

model GoogleReview {
  id             Int      @id @default(autoincrement())
  author         String   @db.VarChar(120)
  rating         Int      @default(5)
  text           String   @db.Text
  reviewDate     DateTime?
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  source         String   @default("MANUAL") @db.VarChar(20)
  googleReviewId String?  @unique @db.VarChar(255)
  authorUri      String?  @db.Text
  authorPhotoUrl String?  @db.Text
  googleMapsUri  String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt @default(now())

  @@index([active, sortOrder])
  @@index([source])
}
